{
  "entities": {
    "property": {
      "title": "Property",
      "description": "A rental property, room, or commercial space",
      "type": "object",
      "properties": {
        "codigo": { "type": "string", "description": "Unique key matching receipts like PVPP, PVJC, etc." },
        "direccion": { "type": "string", "description": "Full address of the property" },
        "parteArrendada": { "type": "string", "description": "Specific portion leased, e.g., entire house, first floor, room 1" },
        "tipoArrendamiento": { "type": "string", "enum": ["completo", "habitacion", "comercial"], "description": "Type of lease: complete, room, or commercial" },
        "estado": { "type": "string", "enum": ["Disponible", "Arrendado", "Mantenimiento"], "description": "Current state of the property" }
      },
      "required": ["codigo", "direccion", "parteArrendada", "tipoArrendamiento", "estado"]
    },
    "tenant": {
      "title": "Tenant",
      "description": "Tenant registered in the property management",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID or document" },
        "nombre": { "type": "string", "description": "Full name of the tenant" },
        "documento": { "type": "string", "description": "Identification document number" },
        "telefono": { "type": "string", "description": "Contact telephone" },
        "email": { "type": "string", "description": "Contact email" },
        "archivoCedulaUrl": { "type": "string", "description": "URL of the uploaded identity proof PDF/Image" },
        "archivoCedulaNombre": { "type": "string", "description": "Filename of the uploaded identity proof" }
      },
      "required": ["id", "nombre", "documento", "telefono", "email"]
    },
    "contract": {
      "title": "Contract",
      "description": "Lease agreement between landlord and tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique lease contract ID" },
        "codigoPropiedad": { "type": "string", "description": "Link to property.codigo" },
        "tenantDocumento": { "type": "string", "description": "Link to tenant.documento" },
        "montoCanon": { "type": "number", "description": "Monthly rent fee" },
        "periodoInicio": { "type": "string", "format": "date", "description": "Contract start date" },
        "periodoFin": { "type": "string", "format": "date", "description": "Contract end date" },
        "fianzaDeposito": { "type": "number", "description": "Security deposit / fianza" },
        "reajusteAnualPercent": { "type": "number", "description": "Annual increase percentage" },
        "estado": { "type": "string", "enum": ["Vigente", "Vencido", "Finalizado"], "description": "Contract status" },
        "archivoContratoUrl": { "type": "string", "description": "URL of the uploaded signed contract" },
        "archivoContratoNombre": { "type": "string", "description": "Filename of the uploaded contract" }
      },
      "required": ["id", "codigoPropiedad", "tenantDocumento", "montoCanon", "periodoInicio", "periodoFin", "fianzaDeposito", "estado"]
    },
    "receipt": {
      "title": "Receipt",
      "description": "Arrendamiento payment receipt issued",
      "type": "object",
      "properties": {
        "numeroRecibo": { "type": "string", "description": "Receipt number e.g., TAPP2026001" },
        "lugarExpedicion": { "type": "string" },
        "fechaExpedicion": { "type": "string" },
        "nombreArrendatario": { "type": "string" },
        "documentoArrendatario": { "type": "string" },
        "telefonoArrendatario": { "type": "string" },
        "emailArrendatario": { "type": "string" },
        "montoPagado": { "type": "number" },
        "montoEnLetras": { "type": "string" },
        "formaPago": { "type": "string" },
        "fechaPago": { "type": "string", "format": "date" },
        "horaPago": { "type": "string" },
        "concepto": { "type": "string" },
        "direccionInmueble": { "type": "string" },
        "parteArrendada": { "type": "string" },
        "periodoInicio": { "type": "string", "format": "date" },
        "periodoFin": { "type": "string", "format": "date" },
        "nombreQuienRecibe": { "type": "string" },
        "cedulaQuienRecibe": { "type": "string" }
      },
      "required": ["numeroRecibo", "nombreArrendatario", "montoPagado", "fechaPago", "direccionInmueble", "concepto"]
    },
    "expense": {
      "title": "Expense",
      "description": "Outflow transaction such as taxes, public utilities, insurance payments or repairs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigoPropiedad": { "type": "string", "description": "Property linked or general" },
        "tipoGasto": { "type": "string", "enum": ["Impuesto", "Servicio Público", "Seguro de Arrendamiento", "Reparación/Mantenimiento", "Otro"] },
        "monto": { "type": "number" },
        "fecha": { "type": "string", "format": "date" },
        "concepto": { "type": "string" },
        "pagado": { "type": "boolean" }
      },
      "required": ["id", "codigoPropiedad", "tipoGasto", "monto", "fecha", "concepto", "pagado"]
    },
    "incident": {
      "title": "Incident",
      "description": "Maintenance ticket or reported damage/incident",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigoPropiedad": { "type": "string" },
        "descripcion": { "type": "string" },
        "prioridad": { "type": "string", "enum": ["Alta", "Media", "Baja"] },
        "estado": { "type": "string", "enum": ["Abierto", "En Proceso", "Resuelto"] },
        "fechaReporte": { "type": "string", "format": "date" },
        "montoEstimado": { "type": "number" }
      },
      "required": ["id", "codigoPropiedad", "descripcion", "prioridad", "estado", "fechaReporte"]
    }
  },
  "firestore": {
    "properties": { "schema": "property", "description": "Rental units, rooms, or storefronts" },
    "tenants": { "schema": "tenant", "description": "Registered tenant profiles" },
    "contracts": { "schema": "contract", "description": "Signed rental contracts and current metadata" },
    "receipts": { "schema": "receipt", "description": "Rent receipt transaction records" },
    "expenses": { "schema": "expense", "description": "Landlord outlays for taxes, services, and insurances" },
    "incidents": { "schema": "incident", "description": "Property damage reports and maintenance tasks" }
  }
}
