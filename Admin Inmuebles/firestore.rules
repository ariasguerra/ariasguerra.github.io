rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedUser() {
      return isSignedIn() 
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'arias.guerra@gmail.com' || request.auth.token.email == 'arias.guerraa@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Property Validation
    function isValidProperty(data) {
      return data.keys().hasAll(['codigo', 'direccion', 'parteArrendada', 'tipoArrendamiento', 'estado'])
        && data.codigo is string && data.codigo.size() <= 20
        && data.direccion is string && data.direccion.size() <= 256
        && data.parteArrendada is string && data.parteArrendada.size() <= 256
        && data.tipoArrendamiento in ['completo', 'habitacion', 'comercial', 'no_aplica']
        && data.estado in ['Disponible', 'Arrendado', 'Mantenimiento'];
    }

    match /properties/{propId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser() && isValidProperty(request.resource.data);
      allow delete: if isAuthorizedUser();
    }

    // Tenant Validation (PII Protection - Pillar 6)
    function isValidTenant(data) {
      return data.keys().hasAll(['nombre', 'documento', 'telefono', 'email'])
        && data.nombre is string && data.nombre.size() <= 128
        && data.documento is string && data.documento.size() <= 30
        && data.telefono is string && data.telefono.size() <= 30
        && data.email is string && data.email.size() <= 128;
    }

    match /tenants/{tenantId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser() && isValidTenant(request.resource.data);
      allow delete: if isAuthorizedUser();
    }

    // Contract Validation
    function isValidContract(data) {
      return data.keys().hasAll(['codigoPropiedad', 'tenantDocumento', 'montoCanon', 'periodoInicio', 'periodoFin', 'fianzaDeposito', 'estado'])
        && data.codigoPropiedad is string && data.codigoPropiedad.size() <= 20
        && data.tenantDocumento is string && data.tenantDocumento.size() <= 30
        && data.montoCanon is number && data.montoCanon >= 0
        && data.periodoInicio is string && data.periodoInicio.size() == 10
        && data.periodoFin is string && data.periodoFin.size() == 10
        && data.fianzaDeposito is number && data.fianzaDeposito >= 0
        && data.estado in ['Vigente', 'Vencido', 'Finalizado'];
    }

    match /contracts/{contractId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser() && isValidContract(request.resource.data);
      allow delete: if isAuthorizedUser();
    }

    // Receipt Validation
    function isValidReceipt(data) {
      return data.keys().hasAll(['numeroRecibo', 'nombreArrendatario', 'montoPagado', 'fechaPago', 'direccionInmueble', 'concepto'])
        && data.numeroRecibo is string && data.numeroRecibo.size() <= 30
        && data.nombreArrendatario is string && data.nombreArrendatario.size() <= 128
        && data.montoPagado is number && data.montoPagado >= 0
        && data.fechaPago is string && data.fechaPago.size() == 10
        && data.direccionInmueble is string && data.direccionInmueble.size() <= 256
        && data.concepto is string && data.concepto.size() <= 128;
    }

    match /receipts/{receiptId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser() && isValidReceipt(request.resource.data);
      allow delete: if isAuthorizedUser();
    }

    // Expense Validation
    function isValidExpense(data) {
      return data.keys().hasAll(['codigoPropiedad', 'tipoGasto', 'monto', 'fecha', 'concepto', 'pagado'])
        && data.codigoPropiedad is string && data.codigoPropiedad.size() <= 30
        && data.tipoGasto in ['Impuesto', 'Servicio Público', 'Seguro de Arrendamiento', 'Reparación/Mantenimiento', 'Otro']
        && data.monto is number && data.monto >= 0
        && data.fecha is string && data.fecha.size() == 10
        && data.concepto is string && data.concepto.size() <= 256
        && data.pagado is bool;
    }

    match /expenses/{expenseId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser() && isValidExpense(request.resource.data);
      allow delete: if isAuthorizedUser();
    }

    // Incident Validation
    function isValidIncident(data) {
      return data.keys().hasAll(['codigoPropiedad', 'descripcion', 'prioridad', 'estado', 'fechaReporte'])
        && data.codigoPropiedad is string && data.codigoPropiedad.size() <= 30
        && data.descripcion is string && data.descripcion.size() <= 512
        && data.prioridad in ['Alta', 'Media', 'Baja']
        && data.estado in ['Abierto', 'En Proceso', 'Resuelto']
        && data.fechaReporte is string && data.fechaReporte.size() == 10;
    }

    match /incidents/{incidentId} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser() && isValidIncident(request.resource.data);
      allow delete: if isAuthorizedUser();
    }

    // Metadata & Seeding Status Validation
    match /metadata/{metaId} {
      allow read, write: if isAuthorizedUser();
    }

    // Liquidations Validation
    match /liquidations/{liqId} {
      allow read, write: if isAuthorizedUser();
    }
  }
}
